# 太初 · 环境变量（复制为 .env 后修改）
TAICHU_DB_PATH=data/taichu_analytics.db
TAICHU_FEEDBACK_DB_PATH=data/taichu_feedback.db
# 必填：≥32 字符强随机密钥（生成：openssl rand -hex 32）；用占位值会在启动时报错
TAICHU_JWT_SECRET=change-me-to-a-random-32-byte-string
TAICHU_ACCESS_TOKEN_TTL=1800
TAICHU_REFRESH_TOKEN_TTL=604800
TAICHU_COST_GATE_MODE=full
TAICHU_VALIDATION_ENABLED=true
# 节141：公开注册开关（内测白名单制）。默认 false=注册端点一律 403，新账号只由后台创建；
# 仅测试/本地造数需要时置 true。
TAICHU_ALLOW_PUBLIC_REGISTER=false
TAICHU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TAICHU_HOST=0.0.0.0
TAICHU_PORT=8000

# --- LLM（DeepSeek 官方 API）---
TAICHU_LLM_API_KEY=sk-your-key-here
TAICHU_LLM_BASE_URL=https://api.deepseek.com
TAICHU_LLM_MODEL=deepseek-v4-flash
TAICHU_LLM_VALIDATION_MODEL=deepseek-v4-flash
TAICHU_LLM_TIMEOUT=60
TAICHU_LLM_MAX_RETRIES=2
TAICHU_LLM_TEMPERATURE=0.3
