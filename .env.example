# 命理 · 环境变量（复制为 .env 后修改）
MINGLI_DB_PATH=data/mingli_analytics.db
MINGLI_FEEDBACK_DB_PATH=data/mingli_feedback.db
# 必填：≥32 字符强随机密钥（生成：openssl rand -hex 32）；用占位值会在启动时报错
MINGLI_JWT_SECRET=change-me-to-a-random-32-byte-string
MINGLI_ACCESS_TOKEN_TTL=1800
MINGLI_REFRESH_TOKEN_TTL=604800
MINGLI_COST_GATE_MODE=full
MINGLI_VALIDATION_ENABLED=true
# 节141：公开注册开关（内测白名单制）。默认 false=注册端点一律 403，新账号只由后台创建；
# 仅测试/本地造数需要时置 true。
MINGLI_ALLOW_PUBLIC_REGISTER=false
MINGLI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MINGLI_HOST=0.0.0.0
MINGLI_PORT=8000

# --- 站点域名（节147：可配置项，真实域名不入库）---
# Caddy 用它申请/续期 Let's Encrypt 证书；**必填**，未配置时 Caddy 会启动失败。
# 仓库里一律写占位域名；你自己的真实域名只写在本机 / 服务器的 .env 里（.env 已被 gitignore）。
MINGLI_SITE_DOMAIN=mingli.example.com
# 可选附加站点（例如自建的 Agent 接入点）：留空/不设 = 用仓库里的空文件（不启用）。
# 要启用：cp ops/deploy/caddy-extra.example ops/deploy/caddy-extra.caddy → 改域名 → 取消下一行注释
# MINGLI_CADDY_EXTRA=./ops/deploy/caddy-extra.caddy

# --- 合规文书运营主体（节147 续：仓库里两份文书只放占位符）---
# 用户协议 / 隐私政策是**线上要展示**的合规文书，必须写真实运营主体；
# 但项目要开源 —— 真实姓名/联系方式留在仓库里等于开源即公开。
# 所以仓库里的 docs/legal/*.md 与 frontend/public/legal/*.html 只含
# {{OPERATOR_NAME}} / {{OPERATOR_CONTACT}} / {{OPERATOR_EMAIL}} 占位符，
# 由后端在服务端渲染时注入（见 backend/app/legal.py）。
# ⚠️ 三项任一为空时 /legal/*.html 返回 500（宁可 500，也不发布没有运营主体的协议）。
MINGLI_OPERATOR_NAME=你的运营者名称
MINGLI_OPERATOR_CONTACT=你的联系方式
MINGLI_OPERATOR_EMAIL=you@example.com

# --- LLM（DeepSeek 官方 API）---
# 请用系统环境变量注入（Windows: setx MINGLI_LLM_API_KEY "<你的 key>"；Linux: export MINGLI_LLM_API_KEY=...），
# 不要把真实 key 写进本项目文件；本行留空即由系统环境变量提供（环境变量优先于 .env）。
MINGLI_LLM_API_KEY=
MINGLI_LLM_BASE_URL=https://api.deepseek.com
MINGLI_LLM_MODEL=deepseek-v4-flash
MINGLI_LLM_VALIDATION_MODEL=deepseek-v4-flash
MINGLI_LLM_TIMEOUT=60
MINGLI_LLM_MAX_RETRIES=2
MINGLI_LLM_TEMPERATURE=0.3
