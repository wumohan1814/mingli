<?xml version="1.0" encoding="utf-8"?>
<!--
  POC-0 清单文件：刻意只用 Android 框架自带能力，不引 AndroidX。
  Application 必须是 Chaquopy 的 PyApplication，否则 Python 无法启动。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 本机回环 HTTP 也需要 INTERNET 权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.chaquo.python.android.PyApplication"
        android:label="命理"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false">

        <!--
          刻意不设 android:usesCleartextTraffic：
          明文流量只允许回环地址，由 network_security_config.xml 的白名单放行。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:label="命理">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
