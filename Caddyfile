# Caddy 反向代理：自动申请/续期 Let's Encrypt HTTPS 证书
taichu.xyz {
    encode gzip zstd
    reverse_proxy web:8000
}

# OpenClaw 接入点：公网可访问（随机子域 + 配对 token 保护），回程走 Tailscale 隧道
# 上游用 Tailscale IP + 显式 SNI（容器内无法解析 MagicDNS 域名）
bb3a.taichu.xyz {
    reverse_proxy https://100.79.80.16:443 {
        transport http {
            tls_insecure_skip_verify
            tls_server_name ecs-openclaw.tail5b95c6.ts.net
        }
        header_up Host {http.request.host}
        header_up X-Forwarded-Proto {scheme}
    }
}
