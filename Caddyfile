# Caddy 反向代理：自动申请/续期 Let's Encrypt HTTPS 证书
#
# 节113：静态资源（js/css/data/vendor/art/tarot/lenormand）改由 Caddy 用 file_server 直出，
#       不再经 Python web 进程（此前实测约 79% 请求是静态）；其余（/api、/admin、/、index.html 等）
#       仍反代到 web:8000。
mingli.example.com {
    encode gzip zstd

    # 静态资源直服：文件名尚无内容 hash → 用 1h max-age + ETag 复验（不上 immutable）。
    # 根 /srv/static 来自 docker-compose 挂载的 frontend/public（只读）。
    @static path /js/* /css/* /data/* /vendor/* /art/* /tarot/* /lenormand/*
    handle @static {
        root * /srv/static
        file_server
        header Cache-Control "public, max-age=3600"
    }

    handle {
        reverse_proxy web:8000
    }
}

# OpenClaw 接入点：公网可访问（随机子域 + 配对 token 保护），回程走 Tailscale 隧道
# 上游用 Tailscale IP + 显式 SNI（容器内无法解析 MagicDNS 域名）
bb3a.mingli.example.com {
    reverse_proxy https://<你的 Tailscale IP>:443 {
        transport http {
            tls_insecure_skip_verify
            tls_server_name <你的 Tailscale 主机名>
        }
        header_up Host {http.request.host}
        header_up X-Forwarded-Proto {scheme}
    }
}