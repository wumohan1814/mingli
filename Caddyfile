# Caddy 反向代理：自动申请/续期 Let's Encrypt HTTPS 证书
#
# 节113：静态资源（js/css/data/vendor/art/tarot/lenormand）改由 Caddy 用 file_server 直出，
#       不再经 Python web 进程（此前实测约 79% 请求是静态）；其余（/api、/admin、/、index.html 等）
#       仍反代到 web:8000。
#
# ── 站点域名：**可配置项，真实域名不入库**（节147，用户 2026-09-14 定） ──────────────
#   `{$MINGLI_SITE_DOMAIN}` 由环境变量注入（docker-compose 从 `.env` 透传；`.env` 已被
#   .gitignore 排除）。**未配置时 Caddy 会直接启动失败** —— 这是有意的：宁可启动就报错，
#   也不要拿一个占位域名去申请 Let's Encrypt 证书（会撞速率限制且签不出有效证书）。
#   本机 / 线上的实际值只存在于各自的 `.env`，仓库里任何地方都不写真实域名。
{$MINGLI_SITE_DOMAIN} {
    encode gzip zstd

    # 静态资源直服：文件名尚无内容 hash → 用 1h max-age + ETag 复验（不上 immutable）。
    # 根 /srv/static 来自 docker-compose 挂载的 frontend/public（只读）。
    @static path /js/* /css/* /data/* /vendor/* /art/* /tarot/* /lenormand/*
    handle @static {
        root * /srv/static
        file_server
        header Cache-Control "public, max-age=3600"
    }

    handle {
        reverse_proxy web:8000
    }
}

# 可选附加站点（例如自建的 Agent 接入点）：默认 import 一份**空文件**，对任何部署都无影响。
# 需要时：cp ops/deploy/caddy-extra.example ops/deploy/caddy-extra.caddy（改成自己的域名）→
#         在 .env 里设 MINGLI_CADDY_EXTRA=./ops/deploy/caddy-extra.caddy
# ⚠️ ops/deploy/caddy-extra.caddy 已被 .gitignore 排除 —— 填进去的真实域名不会进仓库。
import /etc/caddy/extra.caddy
