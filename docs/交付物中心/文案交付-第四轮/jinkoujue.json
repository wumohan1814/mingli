{
  "method": "jinkoujue",
  "methodLabel": "金口诀",
  "cards": [
    {
      "key": "siwei-difen",
      "term": "地分",
      "plain": "金口诀四位之一，由问事方位或随机取地支而定，代表人所处的空间与根基；它像你脚下那块「地」，定下了整个课体的方位坐标。",
      "source": "网络参考改编"
    },
    {
      "key": "siwei-jiangshen",
      "term": "将神",
      "plain": "金口诀四位之一，即十二月将（登明至神后），落于地分之上，代表事体与行动；它象征「事情本身的长相与走向」。",
      "source": "网络参考改编"
    },
    {
      "key": "siwei-guishen",
      "term": "贵神",
      "plain": "金口诀四位之一，即十二贵神之一，落于将神之上，代表权威、环境与外部力量；它像罩在事情外面的「天气与规则」。",
      "source": "网络参考改编"
    },
    {
      "key": "siwei-renyuan",
      "term": "人元",
      "plain": "金口诀四位之一，由五子元遁起出的天干，落于最上层，代表天时与来意；它象征「从天而降的那口气、那点初衷」。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-tianyi",
      "term": "天乙贵神",
      "plain": "十二贵神之首（即贵人），主尊长、权威与庇护，是四位里「外部环境与靠山」的核心意象；它提示可得外力扶持的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-tengshe",
      "term": "螣蛇",
      "plain": "贵神之一，主虚惊、怪异、口舌与心神不宁；它提醒稳情绪、防虚夸，是需留意的小风险意象。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-zhuque",
      "term": "朱雀",
      "plain": "贵神之一，主文书、讯息、口舌；利传播也需防言语分寸，是信息流动的参考符号。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-liuhe",
      "term": "六合",
      "plain": "贵神之一，主和合、合作、中介，是偏吉的协同意象；它提示「借他人之力、达成共识」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-gouchen",
      "term": "勾陈",
      "plain": "贵神之一，主迟滞、争讼、牵连；宜把流程做扎实、留好证据，是阻力型提示。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-longqing",
      "term": "青龙",
      "plain": "贵神之一，主财喜、生机、进取，是偏吉的喜神意象；它代表「顺势得资源」的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-tiankong",
      "term": "天空",
      "plain": "贵神之一，主空虚、不实、诈伪；宜向内沉淀、做研究类的事，是偏中性提示。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-baihu",
      "term": "白虎",
      "plain": "贵神之一，主伤险、肃杀；需守安全边界、合规避险，是需谨慎的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-taichang",
      "term": "太常",
      "plain": "贵神之一，主宴飨、受职、安稳，是偏吉意象；它象征「被认可、得安置」的稳定趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-xuanwu",
      "term": "玄武",
      "plain": "贵神之一，主暗昧、盗失、小人；需守好财物与信息边界，是防风险意象。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-taiyin",
      "term": "太阴",
      "plain": "贵神之一，主阴庇、幕后策划，是偏吉意象；它代表「暗中运筹、借隐力」的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "gui-tianhou",
      "term": "天后",
      "plain": "贵神之一，主慈和、女性、调和，是偏吉意象；它象征关系里的温润与善后之力。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-shenhou",
      "term": "神后",
      "plain": "子位将神，属水，传统象征万物萌发之始、聪慧灵动；它代表事体里「源头、智慧与流动」的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-daji",
      "term": "大吉",
      "plain": "丑位将神，属土，传统主厚实、积蓄与安稳；它提示一种「沉得住、积得下」的势能。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-gongcao",
      "term": "功曹",
      "plain": "寅位将神，属木，传统主文书、功名与进取；它象征「向上争取、立事建功」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-taichong",
      "term": "太冲",
      "plain": "卯位将神，属木，传统主震动、通达与行动力（亦为天马方）；它代表「动起来、破局开路」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-tiangang",
      "term": "天罡",
      "plain": "辰位将神，属土，传统主威严、变化与枢纽（号为天罡）；它提示一种「关键节点、临机应变」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-taiyi",
      "term": "太乙",
      "plain": "巳位将神，属火，传统主文明、机巧与谋略；它象征「灵巧筹划、以智取胜」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-shengguang",
      "term": "胜光",
      "plain": "午位将神，属火，传统主光明、名声与喜庆；它代表「显露锋芒、得人瞩目」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-xiaoji",
      "term": "小吉",
      "plain": "未位将神，属土，传统主和顺、小有收获与温和；它提示「稳妥小成、以柔致利」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-chuansong",
      "term": "传送",
      "plain": "申位将神，属金，传统主传递、迁转与出行（亦为天马方）；它象征「信息流转、远行变动」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-congkui",
      "term": "从魁",
      "plain": "酉位将神，属金，传统主收敛、收获与清肃；它代表「收束成果、去芜存菁」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-hekui",
      "term": "河魁",
      "plain": "戌位将神，属土，传统主狱讼、约束与集结；它提示「守规矩、防官非、聚而有序」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jiang-dengming",
      "term": "登明",
      "plain": "亥位将神，属水，传统主幽隐、清明与通达；它象征「沉静中见明、暗处通途」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "wu-qi",
      "term": "妻动",
      "plain": "五动之一（下克上），传统主内部分歧、财物耗损与门户不和；它提醒以退为进、厘清权责，不是定论破财。",
      "source": "网络参考改编"
    },
    {
      "key": "wu-gui",
      "term": "鬼动",
      "plain": "五动之一（上克下），传统主外部压力、监管阻力或口舌；它提示依法合规、低调防守，别强行出头。",
      "source": "网络参考改编"
    },
    {
      "key": "wu-zei",
      "term": "贼动",
      "plain": "五动之一（下克上），传统主失脱、暗损与防小人；它提醒守好财物合同、防暗中破费。",
      "source": "网络参考改编"
    },
    {
      "key": "wu-fumu",
      "term": "父母动",
      "plain": "五动之一（生出泄气），传统利文书契约、学习深造，但过程繁琐劳碌；它代表「为长远铺路、辛苦换资质」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "wu-zisun",
      "term": "子孙动",
      "plain": "五动之一（生入进益），传统主进益、喜事与外部资源进入；它象征「好事主动来、利于开拓」的偏吉意象。",
      "source": "网络参考改编"
    },
    {
      "key": "san-fang",
      "term": "方主移动",
      "plain": "三动之一，传统主地分（根基）变动，宜异地发展、改变策略；它提示「换地方、换打法」的可能趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "san-shen",
      "term": "神主移动",
      "plain": "三动之一，传统主贵神（环境/贵人）调整，宜紧跟主管与政策指示；它提醒你留意外部环境变动。",
      "source": "网络参考改编"
    },
    {
      "key": "san-jiang",
      "term": "将主移动",
      "plain": "三动之一，传统主将神（自身/事体）奔波忙碌，宜主动出击把握商机；它代表「自身动起来更有利」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "core-yinyang",
      "term": "阴阳次第五用",
      "plain": "金口诀定发用位的口诀（用爻、提出、月将、看日、遁干顺次取用），决定四位里以哪一重为解读主线；它帮你把一课的重心定下来。",
      "source": "网络参考改编"
    },
    {
      "key": "core-dungan",
      "term": "遁干",
      "plain": "即五子元遁起出的天干（人元），是四位最上层的「天时」信息；它给课体补上一层来意与天时的色彩。",
      "source": "网络参考改编"
    },
    {
      "key": "core-kongwang",
      "term": "空亡",
      "plain": "日柱旬空之地支，传统主落空、待填实；它提醒某些条件尚未到位，别急着定论。",
      "source": "网络参考改编"
    },
    {
      "key": "core-wangxiang",
      "term": "旺相休囚死",
      "plain": "五行随月令的盛衰状态，用来判断四位力量的强弱；它像给每个位置打了个「当前气力」的标签。",
      "source": "网络参考改编"
    },
    {
      "key": "core-fayong",
      "term": "发用",
      "plain": "阴阳次第选出的主用位，是整课解读的聚焦点；它相当于「这一课最该看的那一格」。",
      "source": "网络参考改编"
    },
    {
      "key": "core-siwei",
      "term": "四位一体",
      "plain": "金口诀「地分+将神+贵神+人元」合参的整体观，缺一不可；它提醒你别只盯一格，要上下内外连起来看。",
      "source": "网络参考改编"
    }
  ]
}