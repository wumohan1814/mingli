{
  "method": "almanac",
  "methodLabel": "黄历择日",
  "cards": [
    {
      "key": "jianchu-jian",
      "term": "建日",
      "plain": "十二建除之首，主开创与启动（如立基、动土），传统视为当日气场「初生」；它代表一种「适合开头、不宜收尾」的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-chu",
      "term": "除日",
      "plain": "主除旧布新、清洁疗病，传统宜沐浴祈福、忌嫁娶出行；它提示「清掉旧的、轻装上路」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-man",
      "term": "满日",
      "plain": "主充盈圆满，传统宜祭祀纳财、忌动土求医；它象征「丰盛但易满溢」的趋势，宜守不宜冒进。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-ping",
      "term": "平日",
      "plain": "主平顺中和，吉凶平平，一般修屋出行可用；它代表「平常日子、无功无过」的参考意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-ding",
      "term": "定日",
      "plain": "主安定定型，传统宜签约安床、忌动土诉讼；它提示「把事定下来、别再摇摆」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-zhi",
      "term": "执日",
      "plain": "主执着掌控，传统宜捕捉、立约、祭祀，忌远行搬家；它象征「坚守原则、抓住不放」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-po",
      "term": "破日",
      "plain": "主破损离散，传统诸事不宜、唯宜疗病破屋；它提醒「避开喜事、慎防破损」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-wei",
      "term": "危日",
      "plain": "主危险警惕，传统宜安床祈福、忌登高冒险；它提示「小事可办、大事谨慎」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-cheng",
      "term": "成日",
      "plain": "主成就圆满，百事可成，宜开业嫁娶上任；它代表「顺水推舟、易见成果」的偏吉趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-shou",
      "term": "收日",
      "plain": "主收敛收纳，宜收账纳财、忌开业出行；它象征「回笼资源、落袋为安」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-kai",
      "term": "开日",
      "plain": "主开通顺利，百事可行，宜开业出行，忌安葬；它代表「敞开门户、利启新局」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "jianchu-bi",
      "term": "闭日",
      "plain": "主闭藏守静，宜祭祀收纳、忌开业动土；它提示「收口休整、不宜开新」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "huangdao-qinglong",
      "term": "青龙（黄道）",
      "plain": "黄道六神之一，传统主喜庆、安康与生发，偏吉；它代表「顺当、有生气」的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "huangdao-mingtang",
      "term": "明堂（黄道）",
      "plain": "黄道六神之一，传统主光明、公正与议事，偏吉；它象征「堂堂正正、宜公开办事」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "huangdao-jingui",
      "term": "金匮（黄道）",
      "plain": "黄道六神之一，传统主财库、珍藏与稳固，偏吉；它提示「聚财守成、利交易」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "huangdao-tiande",
      "term": "天德（黄道）",
      "plain": "黄道六神之一，传统主天恩庇佑、化解凶险，偏吉；它代表「逢凶可缓、得外界善意」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "huangdao-yutang",
      "term": "玉堂（黄道）",
      "plain": "黄道六神之一，传统主文昌、清贵与安居，偏吉；它提示「利文书安居、气场清和」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "huangdao-siming",
      "term": "司命（黄道）",
      "plain": "黄道六神之一，传统主掌命、司事有成，偏吉；它象征「事有主掌、易成定局」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "heidao-tianxing",
      "term": "天刑（黑道）",
      "plain": "黑道六神之一，传统主刑伤、官非与约束，需谨慎；它提醒你防争执与规则风险。",
      "source": "网络参考改编"
    },
    {
      "key": "heidao-zhuque",
      "term": "朱雀（黑道）",
      "plain": "黑道六神之一，传统主口舌、文书是非，需防言辞；它提示「留意沟通分寸」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "heidao-baihu",
      "term": "白虎（黑道）",
      "plain": "黑道六神之一，传统主伤灾、道路凶险，需守安全；它代表「注意边界、避险」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "heidao-tianlao",
      "term": "天牢（黑道）",
      "plain": "黑道六神之一，传统主拘禁、受阻与迟滞；它提醒事宜留有余地、防被卡住。",
      "source": "网络参考改编"
    },
    {
      "key": "heidao-xuanwu",
      "term": "玄武（黑道）",
      "plain": "黑道六神之一，传统主暗昧、盗失与小人；它提示护好财物信息、防暗损。",
      "source": "网络参考改编"
    },
    {
      "key": "heidao-gouchen",
      "term": "勾陈（黑道）",
      "plain": "黑道六神之一，传统主牵连、争讼与拖延；它象征「事有纠缠、宜理清」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-jiayu",
      "term": "嫁娶",
      "plain": "黄历宜项之一，指结婚嫁娶之事；它只是传统择日里「适合办婚嫁」的参考标签，具体仍看你与现实条件的契合。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-chuxing",
      "term": "出行",
      "plain": "宜项之一，指远行、赴任、旅行；它代表「适合动身、向外走」的趋势提示。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-dongtu",
      "term": "动土",
      "plain": "宜项之一，指破土兴工、修造地基；它提示「适合开工动基」的参考，需结合建除与神煞。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-kaimen",
      "term": "开市",
      "plain": "宜项之一，指店铺开张、交易立券；它代表「适合启动生意、开门纳客」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-anzang",
      "term": "安葬",
      "plain": "宜项之一，指下葬修坟之事；它只是传统里「适合办丧葬」的参考标签，属庄重之事。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-jisi",
      "term": "祭祀",
      "plain": "宜项之一，指敬神祭祖、祈福；它代表「适合静心礼敬、向内祈求」的趋势。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-yixi",
      "term": "移徙",
      "plain": "宜项之一，指搬家、迁居、迁移；它提示「适合换个环境安顿」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-nacai",
      "term": "纳财",
      "plain": "宜项之一，指收账、进货、置产等进财之事；它代表「适合回笼资源」的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-dingmeng",
      "term": "订盟",
      "plain": "宜项之一，指订婚、结盟、签约定约；它提示「适合把关系或合作定下来」的意象。",
      "source": "网络参考改编"
    },
    {
      "key": "yiji-xiuzao",
      "term": "修造",
      "plain": "宜项之一，指盖屋、装修、起基上梁等工程；它代表「适合动工整修」的趋势参考。",
      "source": "网络参考改编"
    },
    {
      "key": "core-chongsha",
      "term": "冲煞",
      "plain": "指当日地支与某生肖/方位相冲，传统视为需回避的方向与属相；它只是「这天对某些人略显紧张」的参考，不必过度解读。",
      "source": "网络参考改编"
    },
    {
      "key": "core-pengzu",
      "term": "彭祖百忌",
      "plain": "以当日干支对应的一句禁忌谚语（如「甲不开仓」），传统用作日常小提醒；它更像古人的生活经验口诀，作趣味参考即可。",
      "source": "网络参考改编"
    },
    {
      "key": "core-ershibasu",
      "term": "二十八宿",
      "plain": "把周天分为二十八个星区，每日轮值一宿并配吉凶，传统用作择日参考；它代表「星象轮值」的趣味趋势标签。",
      "source": "网络参考改编"
    },
    {
      "key": "core-jiuxing",
      "term": "九星",
      "plain": "黄历里的九宫飞星，随日流转影响方位气场；它提示「当天某方位偏旺或偏弱」的参考。",
      "source": "网络参考改编"
    },
    {
      "key": "core-suipo",
      "term": "岁破",
      "plain": "与当年太岁相冲的方位/地支，传统视为当年大忌之所；它提醒重大之事尽量避开该方向。",
      "source": "网络参考改编"
    },
    {
      "key": "core-taisui",
      "term": "太岁",
      "plain": "当年轮值的值年神，传统认为宜静不宜冲；它代表「当年气运的掌舵者」的参考意象，宜敬而远冲。",
      "source": "网络参考改编"
    },
    {
      "key": "core-zhiri",
      "term": "值日",
      "plain": "当日轮值之神（建除或黄黑道）决定当天基调；它像当天的「值班标签」，帮你看整体宜忌倾向。",
      "source": "网络参考改编"
    }
  ]
}