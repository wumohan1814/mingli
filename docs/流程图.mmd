flowchart TB
    %% ============ 顶部状态区（Banner 右上角菜单） ============
    subgraph TopBar["📱 页面顶部 Banner"]
        顶部按钮{"用户状态？"}
        顶部按钮 -->|未登录| 未登录态["🔑 登录 / 📝 注册"]
        顶部按钮 -->|已登录| 汉堡菜单["☰ 汉堡菜单<br/>────────────<br/>① 国学预测 ② 西式占卜 ③ MBTI<br/>④ 档案管理<br/>────────────<br/>🚪 退出登录"]
        汉堡菜单 -->|① ② ③| 首页
        汉堡菜单 -->|④ 档案管理| 档案列表
        汉堡菜单 -->|🚪 退出登录| 未登录态
    end

    %% ============ 首页（落地页，左侧三按钮仅此处） ============
    首页["🏠 首页 · 左侧三按钮（仅落地页显示）<br/>点击按钮文字竖→横、矩形变长，切换落地宣传页"]

    首页 --> 落地选择{"选择模块"}

    国学落地["📜 国学预测 · 落地宣传页<br/>（九法合参）"]
    西式落地["🔮 西式占卜 · 落地宣传页<br/>（星座 · 塔罗 · 雷诺曼）"]
    MBTI落地["🧠 MBTI · 落地宣传页<br/>（16 型人格）"]

    落地选择 --> 国学落地 & 西式落地 & MBTI落地

    %% ============ ① 国学预测 ============
    国学落地 -->|进入国学预测| 国学HUB["📜 国学预测 Hub 页"]
    国学HUB --> 九法合一["A. 九法合一解读<br/>(原有 9 法综合)"]
    国学HUB --> 生肖入口["B. 生肖流年"]
    国学HUB --> 起卦入口["C. 临时起卦<br/>(用已有档案起卦)"]

    %% ---- A. 九法合一（复用国学档案） ----
    九法合一 --> 国学判断{是否有国学档案？}
    国学判断 -->|无档案| 国学新建["📝 新建国学档案"]
    国学判断 -->|已有档案| 档案列表["📂 档案列表（查看解读/命盘/重命名/删除/新建）"]
    档案列表 --> 解读内容页["📖 解读内容页<br/>8 个标题: 综合趋势/性格/事业/财运/<br/>感情/健康/家庭/大势"]
    解读内容页 --> 追问对话框["💬 追问对话框（发送 + 回到解读）"]

    %% ---- B. 生肖流年（确定性零 LLM） ----
    生肖入口 --> 生肖页["🐭 生肖流年页<br/>选生肖 + 年份"]
    生肖页 --> 生肖结果["🎋 生肖流年报告<br/>犯太岁/值年星君/贵人/五行/行动建议<br/>(确定性, 零 LLM)"]
    生肖结果 --> 生肖底部["底部：换生肖/年份 ｜ 返回选项 ｜ 回到首页"]

    %% ---- C. 临时起卦 ----
    起卦入口 --> 起卦判断{是否有国学档案？}
    起卦判断 -->|无档案| 国学新建
    起卦判断 -->|有档案| 起卦选法["🎲 起卦方式选择（复用档案命盘）"]
    起卦选法 --> 起卦方式{"六爻 / 梅花 / 小六壬 / 灵签<br/>大六壬·金口诀·奇门（敬请期待）"}
    起卦方式 --> 起卦执行["⚙️ 执行起卦（确定性）"]
    起卦执行 --> 卦象结果["☯️ 卦象/课式/签文结果页"]
    卦象结果 --> 起卦底部["底部：深度断卦(付费 LLM) ｜ 重新起卦 ｜ 返回选项 ｜ 回到首页"]
    起卦底部 -->|深度断卦| 断卦结果["🔮 断卦解读（LLM 注入命盘+卦象, 即时扣费）"]

    %% ============ ② 西式占卜 ============
    西式落地 -->|进入西式占卜| 西式HUB["🔮 西式占卜 Hub 页"]
    西式HUB --> 星座入口["A. 星座"]
    西式HUB --> 塔罗入口["B. 塔罗牌"]
    西式HUB --> 雷诺曼入口["C. 雷诺曼"]
    西式HUB --> 西式敬请期待["D. 其他西式占卜（敬请期待）"]

    %% ---- A. 星座（复用国学档案） ----
    星座入口 --> 星座页["♈ 星座页<br/>（复用国学档案）"]
    星座页 --> 星座选档案["📂 选择已有档案（case）<br/>复用其生辰信息"]
    星座选档案 --> 星座判断{档案有经纬度？}
    星座判断 -->|无| 星座提示["⚠️ 提示：该档案未提供经纬度，无法生成星盘"]
    星座判断 -->|有| 星盘主界面["♈ 星盘主界面<br/>本命盘（行运/日返/次限/法达 敬请期待）"]
    星盘主界面 --> 星座底部["底部：深度解读(付费) ｜ 返回选项 ｜ 回到首页"]
    星座底部 -->|深度解读| 星座解读["📖 本命深度解读（LLM 即时扣费）"]

    %% ---- B. 塔罗牌 ----
    塔罗入口 --> 塔罗模块["🎴 塔罗牌模块页"]
    塔罗模块 --> 塔罗抽卡["🎴 选方向 + 牌阵 + 逐张翻牌"]
    塔罗抽卡 --> 塔罗结果["🃏 抽卡结果页（牌义/正逆位/关键词）"]
    塔罗结果 --> 塔罗底部["底部：综合解读(付费) ｜ 重新抽卡 ｜ 返回选项 ｜ 回到首页"]
    塔罗底部 -->|综合解读| 塔罗解读["📖 塔罗综合解读（LLM 即时扣费）"]

    %% ---- C. 雷诺曼 ----
    雷诺曼入口 --> 雷诺曼模块["🃏 雷诺曼模块页（36 张小牌）"]
    雷诺曼模块 --> 雷诺曼抽牌["🎴 选牌阵 + 抽牌"]
    雷诺曼抽牌 --> 雷诺曼结果["📜 雷诺曼结果页（牌面 + 关键词组合）"]
    雷诺曼结果 --> 雷诺曼底部["底部：深度解读(付费) ｜ 重新抽牌 ｜ 返回选项 ｜ 回到首页"]

    %% ============ ③ MBTI（复用国学档案） ============
    MBTI落地 -->|开始测试| MBTI模块["🧠 MBTI 人格测试模块页"]
    MBTI模块 --> MBTI选择{"如何测试？"}
    MBTI选择 -->|直接输入类型| MBTI直接输入["⌨️ 16 型宫格直接选型"]
    MBTI选择 -->|开始答题| MBTI答题["📝 60 题逐题二选一（E/I S/N T/F J/P）"]
    MBTI答题 --> MBTI结果判定{"判型 → 4 字母（如 INTJ）"}
    MBTI直接输入 --> MBTI结果判定
    MBTI结果判定 --> MBTI选档案["📂 选择已有档案（case）<br/>判型回写 case.mbti_type"]
    MBTI选档案 --> MBTI结果["🎯 类型大字 + 四维条形图 + 16 型五栏特征"]

    %% ============ 档案列表（复用，跨模块） ============
    档案列表 -.-> 星座选档案
    档案列表 -.-> MBTI选档案

    %% ============ 页面底部 ============
    subgraph BottomBar["📌 页面底部"]
        协议1["📄 用户协议"]
        协议2["🔒 隐私条款"]
        协议3["⚠️ 免责声明"]
    end
    首页 --> BottomBar
