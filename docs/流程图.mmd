flowchart TB
    %% ============ 顶部状态区 ============
    subgraph TopBar["📱 页面顶部"]
        顶部按钮{"用户状态？"}
        顶部按钮 -->|未登录| 未登录态["🔑 登录 / 📝 注册"]
        顶部按钮 -->|已登录| 已登录菜单["☰ 已登录菜单<br/>────────────<br/>① 国学预测 ② 西式占卜 ③ MBTI人格测试<br/>────────────<br/>🚪 退出登录"]
        已登录菜单 -->|① 国学预测| 主页
        已登录菜单 -->|② 西式占卜| 主页
        已登录菜单 -->|③ MBTI人格测试| 主页
        已登录菜单 -->|🚪 退出登录| 未登录态
    end

    %% ============ 主页 ============
    主页["🏠 主页<br/>三大核心入口"]

    subgraph Entries["📌 三大入口模块"]
        入口1["1️⃣ 国学预测"]
        入口2["2️⃣ 西式占卜"]
        入口3["3️⃣ MBTI人格测试"]
    end

    主页 --> 入口1 & 入口2 & 入口3

    %% ============ ① 国学预测 Hub ============
    入口1 --> 国学HUB["📜 国学预测 Hub 页<br/>(背景/配色专属变化)"]
    国学HUB --> 九法合一["A. 九法合一解读<br/>(原有 9 法综合)"]
    国学HUB --> 生肖入口["B. 生肖流年"]
    国学HUB --> 起卦入口["C. 临时起卦<br/>(用已有档案起卦)"]

    %% ---- A. 九法合一（已有核心逻辑） ----
    九法合一 --> 国学判断{是否有国学档案？}
    国学判断 -->|无档案| 国学新建["📝 新建国学档案<br/>(逻辑后续补充)"]
    国学判断 -->|已有档案| 档案操作列表["📂 当前档案操作列表"]
    档案操作列表 --> 操作一查看["① 查看解读"]
    档案操作列表 --> 操作二命盘["② 命盘"]
    档案操作列表 --> 操作三重命名["③ 重命名档案"]
    档案操作列表 --> 操作四删除["④ 删除档案"]
    档案操作列表 --> 操作五新建["⑤ 新建档案"]

    操作五新建 --> 国学新建
    档案操作列表 --> 操作二命盘
    操作一查看 --> 解读内容页["📖 解读内容页<br/>8 个标题: 综合趋势/性格/事业/财运/<br/>感情/健康/家庭/大势"]
    解读内容页 --> 综合趋势["综合趋势<br/>(无追问按钮, 仅展示解读)"]
    解读内容页 --> 解读条目{"性格/事业/财运/感情<br/>健康/家庭/大势<br/>(7 项, 各有追问按钮)"}
    解读条目 --> 追问按钮["每个标题下:<br/>📄 解读内容 ＋ 💬 追问按钮"]
    追问按钮 --> 追问对话框["💬 进入追问对话框"]

    解读条目 --> 解读底部按键["底部按键:<br/>① 追问解读 ｜ ② 查看命盘 ｜ ③ 回到档案列表 ｜ ④ 回到首页"]
    追问对话框 --> 追问布局{"追问对话框布局"}
    追问布局 --> 追问上方["⬆️ 上方: 该标题的详细解读"]
    追问布局 --> 追问下方["⬇️ 下方: 对话框 + [发送] + [回到解读]"]
    追问下方 --> 追问发送["[发送] ➡️ 发送追问"]
    追问下方 --> 回到解读["[回到解读] ➡️ 返回解读内容页"]

    命盘底部按键["命盘底部按键:<br/>① 查看解读 ｜ ② 回到档案列表 ｜ ③ 回到首页"]
    命盘底部按键 -->|① 查看解读| 解读内容页
    命盘底部按键 -->|② 回到档案列表| 档案操作列表
    命盘底部按键 -->|③ 回到首页| 主页
    操作二命盘 --> 命盘界面["🗓️ 命盘查看页<br/>当前档案的国学排盘情况"]
    命盘界面 --> 命盘底部按键
    追问发送 --> 追问下方
    解读底部按键 -->|① 追问解读| 追问对话框
    解读底部按键 -->|② 查看命盘| 命盘界面
    解读底部按键 -->|③ 回到档案列表| 档案操作列表
    解读底部按键 -->|④ 回到首页| 主页
    综合趋势 --> 解读底部按键

    %% ---- B. 生肖流年（确定性，零 LLM） ----
    生肖入口 --> 生肖页["🐭 生肖流年页<br/>选生肖 + 年份"]
    生肖页 --> 生肖结果["🎋 生肖流年报告<br/>犯太岁 / 值年星君 / 贵人 /<br/>五行关系 / 行动建议<br/>(确定性, 零 LLM)"]
    生肖结果 --> 生肖底部["底部按键:<br/>① 换生肖/年份 ｜ ② 回到 Hub ｜ ③ 回到首页"]
    生肖底部 -->|回到 Hub| 国学HUB
    生肖底部 -->|回到首页| 主页

    %% ---- C. 临时起卦（用已有档案） ----
    起卦入口 --> 起卦判断{是否有国学档案？}
    起卦判断 -->|无档案| 国学新建
    起卦判断 -->|有档案| 起卦选法["🎲 起卦方式选择<br/>(复用已有档案命盘)"]
    起卦选法 --> 起卦方式{"选择起卦方式"}
    起卦方式 --> 六爻["六爻<br/>(摇卦/报数)"]
    起卦方式 --> 梅花["梅花易数<br/>(时间/报数)"]
    起卦方式 --> 小六壬["小六壬<br/>(月日时速断)"]
    起卦方式 --> 灵签["观音灵签<br/>(抽签)"]
    起卦方式 --> 六壬["大六壬<br/>(时辰起课)·敬请期待"]
    起卦方式 --> 金口诀["金口诀<br/>(时辰起课)·敬请期待"]
    起卦方式 --> 奇门时家["奇门时家<br/>(时家奇门)·敬请期待"]
    六爻 --> 起卦执行["⚙️ 执行起卦<br/>(确定性计算)"]
    梅花 --> 起卦执行
    小六壬 --> 起卦执行
    灵签 --> 起卦执行
    六壬 --> 起卦执行
    金口诀 --> 起卦执行
    奇门时家 --> 起卦执行
    起卦执行 --> 卦象结果["☯️ 卦象/课式/签文结果页<br/>(确定性展示)"]
    卦象结果 --> 起卦底部["底部按键:<br/>① [可选] 深度断卦(付费 LLM) ｜ ② 重新起卦 ｜<br/>③ 回到 Hub ｜ ④ 回到首页"]
    起卦底部 -->|深度断卦| 断卦结果["🔮 断卦解读<br/>(LLM, 注入命盘+卦象, 即时扣费)"]
    起卦底部 -->|重新起卦| 起卦选法
    起卦底部 -->|回到 Hub| 国学HUB
    起卦底部 -->|回到首页| 主页

    %% ============ ② 西式占卜 Hub ============
    入口2 --> 西式HUB["🔮 西式占卜 Hub 页<br/>(背景/配色专属变化)"]
    西式HUB --> 星座入口["A. 星座预测"]
    西式HUB --> 塔罗入口["B. 塔罗牌"]
    西式HUB --> 雷诺曼入口["C. 雷诺曼"]
    西式HUB --> 西式敬请期待["D. 其他西式占卜<br/>(敬请期待)"]

    %% ---- A. 星座预测 ----
    星座入口 --> 星座模块["♈ 星座预测模块页<br/>(背景变化)"]
    星座模块 --> 星座档案判断{是否有星座档案？}
    星座档案判断 -->|有档案| 星座档案列表["📂 星座档案操作列表<br/>(查看/重命名/删除/新建)"]
    星座档案判断 -->|无档案| 星座新建档案["📝 新建星座档案<br/>(选择出生日期 → 生成本命盘)"]

    星座档案列表 --> 星盘主界面["♈ 星盘主界面<br/>子菜单左右滑动切换星盘"]
    星座档案列表 -->|重命名| 星座新建档案
    星座档案列表 -->|删除| 星座确认删除["⚠️ 删除二次确认弹窗"]
    星座档案列表 -->|新建| 星座新建档案
    星座新建档案 --> 星盘主界面
    星座确认删除 --> 星座档案列表
    星盘主界面 --> 星盘切换{"子菜单左右滑动<br/>本命 / 行运(流年·流月·流日) /<br/>日返 / 次限 / 法达"}

    星盘切换 --> 当前星盘{"选定星盘<br/>（如: 本命盘）"}
    当前星盘 --> 日期选择["📅 选择日期<br/>(不同日期影响该星盘解读)"]
    日期选择 --> 星座解读生成{"通用解读引擎<br/>按星盘类型调用对应解读"}
    日期选择 --> 本命解读{"本命盘解读<br/>① 太阳星座 ② 月亮星座 ③ 上升星座"}
    日期选择 --> 行运解读{"行运盘解读<br/>(流年/流月/流日)"}
    日期选择 --> 日返解读{"日返盘解读"}
    日期选择 --> 次限解读{"次限盘解读"}
    日期选择 --> 法达解读{"法达盘解读<br/>(自研查表)"}

    本命解读 --> 本命三解读["太阳星座 / 月亮星座 / 上升星座<br/>各生成独立解读内容"]
    行运解读 --> 行运结果["行运盘解读结果"]
    法达解读 --> 法达结果["法达盘解读结果"]
    次限解读 --> 次限结果["次限盘解读结果"]
    日返解读 --> 日返结果["日返盘解读结果"]

    星盘主界面 --> 星座底部按键["底部按键:<br/>① 切换星盘 ｜ ② 选择日期 ｜<br/>③ [可选] 深度解读(付费) ｜ ④ 回到 Hub ｜ ⑤ 回到首页"]

    %% ---- B. 塔罗牌 ----
    塔罗入口 --> 塔罗模块["🎴 塔罗牌模块页<br/>(背景/配色专属变化)<br/>👇 [进入预测] 按钮"]
    塔罗模块 -->|点击进入预测| 塔罗档案判断{是否有塔罗档案？}
    塔罗档案判断 -->|有档案| 塔罗档案列表["📂 塔罗档案操作列表<br/>(查看/重命名/删除/新建)"]
    塔罗档案判断 -->|无档案| 塔罗新建档案["📝 新建塔罗档案"]

    塔罗档案列表 --> 档案内操作{"档案内操作"}
    档案内操作 -->|查看| 塔罗抽卡页["🎴 抽卡页"]
    档案内操作 -->|重命名| 塔罗新建档案
    档案内操作 -->|删除| 塔罗确认删除["⚠️ 删除二次确认弹窗"]
    档案内操作 -->|新建| 塔罗新建档案
    塔罗确认删除 --> 档案内操作

    塔罗新建档案 --> 塔罗档案列表
    塔罗抽卡页 --> 抽卡方向选择{"选择预测方向<br/>(爱情/事业/财运/综合/成长…)"}
    抽卡方向选择 --> 抽卡方式选择{"选择抽卡方式<br/>(单张 / 三张过去-现在-未来 /<br/>十字牌阵 / 宾主位等)"}
    抽卡方式选择 --> 执行抽卡["🎴 执行抽卡<br/>(随机抽牌 + 展示牌阵与卡牌外形)"]
    执行抽卡 --> 塔罗结果页["🃏 抽卡结果页<br/>显示抽到的卡片及卡牌外形<br/>＋ 牌义/正逆位/关键词"]
    塔罗结果页 --> 塔罗底部["底部按键:<br/>① [可选] 综合解读(付费 LLM) ｜ ② 重新抽卡 ｜<br/>③ 回到 Hub ｜ ④ 回到首页"]
    塔罗底部 -->|综合解读| 塔罗解读["📖 塔罗综合解读<br/>(LLM, 即时扣费)"]

    %% ---- C. 雷诺曼 ----
    雷诺曼入口 --> 雷诺曼模块["🃏 雷诺曼模块页<br/>(36 张小牌占卜)"]
    雷诺曼模块 --> 雷诺曼抽牌["🎴 选择牌阵 + 抽牌<br/>(单张 / 三张 / 九宫格)"]
    雷诺曼抽牌 --> 雷诺曼结果["📜 雷诺曼结果页<br/>牌面 + 关键词组合解读"]
    雷诺曼结果 --> 雷诺曼底部["底部按键:<br/>① [可选] 深度解读(付费) ｜ ② 重新抽牌 ｜<br/>③ 回到 Hub ｜ ④ 回到首页"]

    %% ============ ③ MBTI 人格测试 ============
    入口3 --> MBTI模块["🧠 MBTI人格测试模块页<br/>(背景变化)"]
    MBTI模块 -->|点击进入| MBTI新建判断{是否新建 MBTI 档案？}
    MBTI新建判断 -->|直接输入已知类型| MBTI直接输入["⌨️ 直接输入已知 MBTI 人格类型"]
    MBTI新建判断 -->|开始答题| MBTI答题流程["📝 MBTI 完整答题流程<br/>(全部题目作答后确定人格类型)"]

    MBTI答题流程 --> MBTI题目展示["逐题展示题目 + 四选一选项<br/>(逻辑逐项判定 E/I T/F S/N…)"]
    MBTI题目展示 --> MBTI答题底部{"答题进度"}
    MBTI答题底部 -->|还有题目| MBTI题目展示
    MBTI答题底部 -->|全部答完| MBTI结果判定{"统计维度得分<br/>得出 4 字母类型<br/>(如 INTJ)"}
    MBTI直接输入 --> MBTI结果判定

    MBTI结果判定 --> MBTI人格确定["🧬 确定人格类型<br/>生成人格档案"]
    MBTI人格确定 --> MBTI档案列表["📂 MBTI 档案操作列表<br/>(查看/重命名/删除/新建)"]
    MBTI人格确定 --> MBTI特征展示["🎯 人格特征展示页<br/>该类型在各维度上的表现与特征"]

    MBTI档案列表 --> MBTI底部按键["底部按键:<br/>① 查看档案 ｜ ② 重新测试 ｜ ③ 档案操作 ｜ ④ 回到首页"]
    MBTI特征展示 --> MBTI档案列表

    %% ============ 页面底部 ============
    subgraph BottomBar["📌 页面底部"]
        协议1["📄 用户协议"]
        协议2["🔒 隐私条款"]
        协议3["⚠️ 免责声明"]
    end
    主页 --> BottomBar
